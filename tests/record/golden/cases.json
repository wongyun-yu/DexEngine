 "force.RULE": [
  {
   "f_spike_n": 170.0,
   "fill": "fill only flag runs shorter than jam_seconds — linear interpolation in time between the normal samples (outside the flag · after the hold) just before and just after, same key and same column · keep the one value when only one side exists · raw value when neither exists or the run is jam_seconds or longer",
   "jam_peak_n": 1000.0,
   "jam_seconds": 0.5,
   "owner": "scripts/collect/collect_force.py",
   "pad_samples": 1,
   "wedge_cos": -0.8,
   "wedge_n": 100.0
  },
  {
   "<stem>.force_n_clean": "cleaned force — same shape as the raw <stem>.force_n · only filled samples are filled by the fill rule · the rest = raw values",
   "quality.filled": "flagged samples filled in the cleaned channel (fill rule)",
   "quality.flag": "spike flag — after the hold, (spike ± pad_samples samples) ∪ wedge",
   "quality.pinned": "hold-window samples (policy step ≤ spawn_hold_steps — right after reset + the window that rewrites the object to its reference pose)",
   "quality.spike": "samples where any link has |F| > f_spike_n (hold window included)",
   "quality.wedge": "wedge samples — two links of one hand (one total-force sensor) push in opposite directions (cos ≤ wedge_cos), each ≥ wedge_n (hold window included)"
  }
