MULTIGPU= GPU=0
EXTRA=--collision_curriculum 0 --arm rby1 --hand sharpa_wave --obj_track_grace 60 LGATE_RAMP=0.10,180
ROSTER_RECORD=overfit/logs/refbase/GOLD_judge_bi_sharpa_wave_frozenreplay_roster.txt SEQ_DIR=<MAIN>/data/hot3d/trees/rby1_sharpa_wave/bimanual
