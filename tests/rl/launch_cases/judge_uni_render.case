## env
DRYRUN=1
GPU=0
WANDB_GROUP=dry
BI_NEED_MIB=0
BI_RENDER_NEED_MIB=0
SIDE=right
SEQ_DIR=<MAIN>/data/hot3d/trees/rby1_sharpa_wave/right
ARM=rby1
HAND=sharpa_wave
DEXENGINE_ARM=rby1
DEXENGINE_HAND=sharpa_wave
DEXENGINE_DATASET=hot3d
DEXENGINE_EMBODIMENT=right
FROZEN_REPLAY_CKPT=<MAIN>/overfit/hands/sharpa_wave/rl_campaigns/shrd22_20261016/hot3d/hot3d.both-sh.hot1016b.01/skrl/V2C_shrd22_20261016__sharpa_wave_hot3d_both_sh_hot1016b_01_s42/checkpoints/agent_51200.pt
FROZEN_REPLAY_EVALS_PER_CLIP=64
FROZEN_REPLAY_ITER=1600
FROZEN_RENDER_OUT=<S>/tmp/vids
## manifest
MODE=frozenreplay OUT=EXT_judge_uni_render_frozenreplay
RUN=EXT_judge_uni_render SIDE=right SEQ=dir:right OBJ=(seqdir) NE=4096 MI=1600 MB=yaml TIGHTEN=0.5 NOCOL=0
GATE=POS_CONST=5 ROT_CONST=90 LAGW=25 WRIST=--wrist_pos_residual_max_m 0.07 --wrist_rot_residual_max_deg 120 --wrist_l2_hinge 1 --wrist_l2_hinge_free_frac 0.7 --wrist_l2_hinge_start_frac 0.10 --wrist_l2_hinge_end_frac 0.25 OBJ_OBS_FIXED=1
MULTIGPU= GPU=0
EXTRA=--arm rby1 --hand sharpa_wave
TRAIN_EXTRA=
ROSTER_RECORD=overfit/logs/refbase/EXT_judge_uni_render_frozenreplay_roster.txt SEQ_DIR=<MAIN>/data/hot3d/trees/rby1_sharpa_wave/right
DEXENGINE_ARM_IK_DIR_SUFFIX=_cont25
DEXENGINE_ARM=rby1
DEXENGINE_CKPT_INTERVAL=50
DEXENGINE_COMBO_USD_VARIANT=_mi_armhull
DEXENGINE_DATASET=hot3d
DEXENGINE_DESK_ROBOT_NOCOLL=0
DEXENGINE_EMBODIMENT=right
DEXENGINE_ENVZ=1
DEXENGINE_HAND=sharpa_wave
