## env
DRYRUN=1
GPU=0
WANDB_GROUP=dry
BI_NEED_MIB=0
BI_RENDER_NEED_MIB=0
SIDE=right
SEQ_DIR=<S>/views/right2
ARM=rby1
HAND=sharpa_wave
DEXENGINE_ARM=rby1
DEXENGINE_HAND=sharpa_wave
DEXENGINE_DATASET=hot3d
DEXENGINE_EMBODIMENT=right
RENDER_ONLY=replay
MI=1600
DEXENGINE_CKPT_INTERVAL=50
## manifest
MODE=replay OUT=EXT_replay_uni_replay
RUN=EXT_replay_uni SIDE=right SEQ=dir:right2 OBJ=(seqdir) NE=4096 MI=1600 MB=yaml TIGHTEN=0.5 NOCOL=0
GATE=POS_CONST=5 ROT_CONST=90 LAGW=25 WRIST=--wrist_pos_residual_max_m 0.07 --wrist_rot_residual_max_deg 120 --wrist_l2_hinge 1 --wrist_l2_hinge_free_frac 0.7 --wrist_l2_hinge_start_frac 0.10 --wrist_l2_hinge_end_frac 0.25 OBJ_OBS_FIXED=1
MULTIGPU= GPU=0
EXTRA=--arm rby1 --hand sharpa_wave
TRAIN_EXTRA=
ROSTER_RECORD=overfit/logs/refbase/EXT_replay_uni_replay_roster.txt SEQ_DIR=<S>/views/right2
DEXENGINE_ARM_IK_DIR_SUFFIX=_cont25
DEXENGINE_ARM=rby1
DEXENGINE_CKPT_INTERVAL=50
DEXENGINE_COMBO_USD_VARIANT=_mi_armhull
DEXENGINE_DATASET=hot3d
DEXENGINE_DESK_ROBOT_NOCOLL=0
DEXENGINE_EMBODIMENT=right
DEXENGINE_ENVZ=1
DEXENGINE_HAND=sharpa_wave
DEXENGINE_INTRAIN_EVAL=0
DEXENGINE_MAIN_ROOT=<MAIN>
DEXENGINE_MOUNT_TOL=0.0025
DEXENGINE_RBY1_BASE_POS=-0.70,0.0,0.0
DEXENGINE_ROBOT_Z_OFF=0
## dump EXT_replay_uni_p0003_d0ad9b47__s00089_e00355_pl_rt_replay_render.log
