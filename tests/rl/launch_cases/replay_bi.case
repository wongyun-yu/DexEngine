## env
DRYRUN=1
GPU=0
WANDB_GROUP=dry
BI_NEED_MIB=0
BI_RENDER_NEED_MIB=0
SIDE=both
SEQ_DIR=<S>/views/bi2
ARM=rby1
HAND=sharpa_wave
DEXENGINE_ARM=rby1
DEXENGINE_HAND=sharpa_wave
DEXENGINE_DATASET=hot3d
DEXENGINE_EMBODIMENT=bimanual
RENDER_ONLY=replay
MI=1600
DEXENGINE_CKPT_INTERVAL=50
## manifest
MODE=render OUT=EXT_replay_bi_render
RUN=EXT_replay_bi SIDE=both SEQ=dir:bi2 TOOL=seqdir LOBJ=seqdir NE=4096 MI=1600 MB=16 TIGHTEN=0.5 NOCOL=0 ROBOT_Z=0
COLL_PRESET=canon_r2r3off
RESET_SCHEME=or PSA_FLAGS=--per_side_advantage 1 WRIST_CAPS=--wrist_pos_residual_max_m 0.07 --wrist_rot_residual_max_deg 120 HINGE=--wrist_l2_hinge 1 --wrist_l2_hinge_free_frac 0.7 --wrist_l2_hinge_start_frac 0.10 --wrist_l2_hinge_end_frac 0.25 strip_power=1 force_window_post=100000 FORCE_DIR=1 OBJ_OBS_FIXED=1
MULTIGPU= GPU=0
EXTRA=--collision_curriculum 0 --arm rby1 --hand sharpa_wave --obj_track_grace 60 LGATE_RAMP=0.10,180
ROSTER_RECORD=overfit/logs/refbase/EXT_replay_bi_render_roster.txt SEQ_DIR=<S>/views/bi2
DEXENGINE_ARM_IK_DIR_SUFFIX=_cont25
DEXENGINE_ARM_OBJ_NOCOLL=0
DEXENGINE_ARM=rby1
DEXENGINE_BI_SELFCOLL=0
DEXENGINE_BI_SPLIT_ARTIC=1
DEXENGINE_BI_SPLIT_OFF=r2,r3l
DEXENGINE_CKPT_INTERVAL=50
DEXENGINE_COLL_PRESET=canon_r2r3off
DEXENGINE_COMBO_USD_VARIANT=_mi_armhull
DEXENGINE_COMBO_VARIANT=
DEXENGINE_DATASET=hot3d
DEXENGINE_DESK_ROBOT_NOCOLL=0
DEXENGINE_EMBODIMENT=bimanual
DEXENGINE_ENVZ=1
DEXENGINE_EVAL_CROSS_OFF=0
DEXENGINE_HAND=sharpa_wave
DEXENGINE_INTRAIN_EVAL=0
DEXENGINE_MAIN_ROOT=<MAIN>
DEXENGINE_MEM_RESTART_FREE_GB=3
DEXENGINE_MOUNT_TOL=0.0025
DEXENGINE_OBJ_REF_VEL_INIT=1
DEXENGINE_OBJ_SPAWN_HOLD=10
DEXENGINE_ROBOT_Z_OFF=0
