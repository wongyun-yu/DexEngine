# configs/pipeline.env — the single configuration of the stage pipeline.
#
# Format: bash does not `source` this file. `_lib.sh:pipeline_config_read` parses it line by line as `KEY=VALUE`
# (`k=${line%%=*}`), so an expansion such as `${VAR:?...}` would be exported literally — do not use one.
# "Required" is written as an empty value; the consumer dies when it is still empty (see each line).
# Accepted keys: `_lib.sh` PIPELINE_CONFIG_KEYS. Any other key, or a line that is not KEY=VALUE, is rc 2.
#
# Priority: this file < environment variables < command-line options (`--arm` etc.). Another file: `PIPELINE_CONFIG=<file>`.
# What the values mean and how to add one: docs/configuration.md · docs/pipeline.md.

# ── What runs ─────────────────────────────────────────────────────────────────
# Identity inputs have no default. When ARM or DATASET is empty, `pipeline_init` names the missing input
# (`--arm`/`ARM=` · `--dataset`/`DATASET=`) and exits with rc 2.
ARM=                       # arm: required. Registered combos: `dexengine/core/paths.py --what combo-ids`
# HAND has no default. When empty, `pipeline_registry_check` exits with "[pipeline] not registered: ...".
# Pass it as `--hand <hand>` or `HAND=<hand>`.
HAND=                      # hand: required. Registered values: `dexengine/core/paths.py --what hand-spec-dirs`
DATASET=                   # dataset adapter: required. Registered values: `dexengine/core/paths.py --what datasets`
# Embodiment follows the same rule as arm and dataset. When empty, `pipeline_init` names the missing input
# (`--emb`/`EMB=`) and exits with rc 2. Accepted values: data_layout.EMBODIMENTS.
EMB=                       # embodiment: required. `--emb <emb>` or `EMB=<emb>`

# ── Where things are (install paths) ──────────────────────────────────────────
# Repository-relative paths resolve against the repository root.
ISAACLAB_DIR=                               # empty: scripts/_rl_recipe.sh finds it (repo → main checkout → git common dir). Otherwise an absolute path
RETARGET_PY=                                # empty: dexengine/core/paths.py --what retarget-py finds it (the main checkout's .venv). Otherwise an absolute path
DEXENGINE_MAIN_ROOT=                          # checkout that holds data/ (raw data · trees · USD cache). Empty = repo root (in a worktree, name the main checkout)

# ── Stage-3 sample and GPU (both required) ────────────────────────────────────
# GPU has no default: a missing `--gpu` must not land on another project's GPU. When empty,
# the stage-3 launcher (scripts/stage3_rl.py → dexengine/rl/launch/request.py) refuses the run.
GPU=                       # required: `--gpu N` or `GPU=N`
# SEQ_DIR has no default: a default tree would silently train another hand's bundle. When empty,
# dexengine/rl/launch/request.py raises "seq_dir (SEQ_DIR) is required (no default)".
SEQ_DIR=                   # required: combo tree root (or a clip folder); a bundle passes the selector's list file as DEXENGINE_SEQ_LIST
