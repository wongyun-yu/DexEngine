new file mode 100644
index 0000000..88e859a
--- /dev/null
+++ b/dexmachina/envs/hand_cfgs/sharpa_wave.py
@@ -0,0 +1,51 @@
+"""SharpA Wave (22-dof) hand config -- added for the E1-E3 TACO baseline, following the
+hand-processing doc (1_process_hands, step 6). Asset: assets/sharpa_wave_hand/ (vendor URDF + their add_wrist_dof.py;
+built by experiments/baselines/dexmachina/build_sharpa_asset.py). collision_groups: their divide_hand_groups() with
+palm = *_hand_C_MC (experiments/baselines/dexmachina/sharpa_collision_groups.py; identical for left and right).
+
+Actuators. Their step 7 (gain tuning) needs an on-screen viewer, which a headless run does not have, so no
+tuning was done:
+  - wrist (virtual 6-dof floating base, joint names from add_wrist_dof.py): the authors' Schunk values
+    (envs/hand_cfgs/schunk.py) -- the shipped hand with the closest mass (SharpA ~1.31 kg incl. flange).
+  - fingers: the SharpA actuator model the rest of our E1-E3 table uses (DexEngine HandSpec SHARPA finger_kp /
+    finger_kd / finger_effort = vendor effort caps), one group per joint class.
+"""
+from os.path import join
+from dexmachina.asset_utils import get_urdf_path
+
+sharpa_asset_dir = "sharpa_wave_hand/"
+left_rel_urdf = join(sharpa_asset_dir, "left_sharpa_wave_6dof.urdf")
+right_rel_urdf = join(sharpa_asset_dir, "right_sharpa_wave_6dof.urdf")
+
+_SIDES = r"(right|left)"
+SHARPA_ACTUATORS = {
+    "finger_thumb_cmc": dict(joint_exprs=[_SIDES + r"_thumb_CMC_(FE|AA)$"], kp=13.0, kv=2.6, force_range=3.3),
+    "finger_mcp": dict(joint_exprs=[_SIDES + r"_(thumb|index|middle|ring|pinky)_MCP_(FE|AA)$"], kp=8.0, kv=1.7,
+                       force_range=1.864),
+    "finger_pip": dict(joint_exprs=[_SIDES + r"_(index|middle|ring|pinky)_PIP$", _SIDES + r"_thumb_IP$"], kp=3.0, kv=0.8,
+                       force_range=0.638),
+    "finger_dip": dict(joint_exprs=[_SIDES + r"_(index|middle|ring|pinky)_DIP$"], kp=1.5, kv=0.45, force_range=0.189369),
+    "finger_pinky_cmc": dict(joint_exprs=[_SIDES + r"_pinky_CMC$"], kp=3.0, kv=0.8, force_range=0.5285),
+    "wrist_rot": dict(joint_exprs=[r'[LR]_forearm_(roll|pitch|yaw)_link_joint'], kp=80, kv=5, force_range=100),
+    "wrist_trans": dict(joint_exprs=[r'[LR]_forearm_t[xyz]_link_joint'], kp=350, kv=8, force_range=100),
+}
+# link local idx -> group (0 = wrist+palm, 1..5 = thumb, index, middle, ring, pinky chains); same for both sides
+SHARPA_COLLISION_GROUPS = {8: 0, 9: 0, 15: 1, 16: 2, 17: 3, 18: 4, 19: 5, 21: 2, 22: 3, 23: 4, 24: 5, 25: 1, 26: 2,
+                           27: 3, 28: 4, 29: 5, 30: 1, 31: 2, 32: 3, 33: 4, 34: 5, 35: 1, 39: 5}
+
+
+def _side_cfg(side, rel_urdf):
+    return {
+        "urdf_path": get_urdf_path(rel_urdf),
+        "wrist_link_name": f"{side}_hand_C_MC",   # palm link
+        "kpt_link_names": [f"{side}_{f}_fingertip" for f in ("thumb", "index", "middle", "ring", "pinky")],
+        "actuators": {k: dict(v) for k, v in SHARPA_ACTUATORS.items()},
+        "collision_groups": dict(SHARPA_COLLISION_GROUPS),
+        "collision_palm_name": f"{side}_hand_C_MC",
+    }
+
+
+SHARPA_WAVE_CFGs = dict(
+    left=_side_cfg("left", left_rel_urdf),
+    right=_side_cfg("right", right_rel_urdf),
+)
